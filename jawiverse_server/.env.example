# Copy this file to ".env" and fill in your real values (keep both files --
# .env.example as the template, .env as your real, git-ignored credentials).
# ".env" is git-ignored -- never commit real credentials.

TG_BOT_TOKEN=your-telegram-bot-token-here
TG_CHAT_ID=your-telegram-chat-id-here

# Optional, telegram_bot.py only: comma-separated list of chat IDs allowed to
# talk to the bot. If unset, TG_CHAT_ID above is used as the sole allowed ID.
# ALLOWED_CHAT_IDS=123456789,987654321

# Optional: default model when --model / --model-path isn't passed. A dataset
# folder name (prefix is enough), newest version unless one is given.
# telegram_bot.py reads it from here; for infer_jawi_rumi.py, export it.
# JAWIVERSE_MODEL=risalah
# JAWIVERSE_MODEL=risalah:v1
